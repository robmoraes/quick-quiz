{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: test",
      "type": "shell",
      "command": "go test ./...",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "api: run",
      "type": "shell",
      "command": "go run ./cmd/api",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "spa-dev: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/spa-dev"
      },
      "problemMatcher": []
    },
    {
      "label": "spa-dev: lint",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/apps/spa-dev"
      },
      "group": "test",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "spa-dev: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/apps/spa-dev"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
