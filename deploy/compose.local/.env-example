# Add deploy/compose.secrets.yml and set QUICKQUIZ_SECRETS_ROOT to mount
# per-service files at /run/secrets. A defined __FILE value takes priority.
# QUICKQUIZ_SECRETS_ROOT=/absolute/path/to/quickquiz-secrets

COMPOSE_PROJECT_NAME=quickquiz-dev

QUICKQUIZ_IMAGE_API=robmoraes/quick-quiz-api:latest
QUICKQUIZ_IMAGE_REDIS=redis:7.4-alpine
QUICKQUIZ_IMAGE_POSTGRES=postgres:17-alpine
QUICKQUIZ_IMAGE_ADS_API=robmoraes/quick-quiz-ads-api:latest
QUICKQUIZ_IMAGE_DEV=robmoraes/quick-quiz-dev:latest
QUICKQUIZ_IMAGE_DSLAB=robmoraes/quick-quiz-dslab:latest
QUICKQUIZ_IMAGE_MANAGER_FPM=robmoraes/quick-quiz-manager-fpm:latest
QUICKQUIZ_IMAGE_MANAGER_WEB=robmoraes/quick-quiz-manager-web:latest

API_HTTP_PORT=8080
ADS_API_HTTP_PORT=8084
SPA_HTTP_PORT=8082
DSLAB_HTTP_PORT=8083
MANAGER_HTTP_PORT=8081
SPA_DEV_API_BASE_URL=http://localhost:8080
SPA_DEV_ADS_API_BASE_URL=http://localhost:8084
SPA_DSLAB_API_BASE_URL=http://localhost:8080
SPA_DSLAB_ADS_API_BASE_URL=http://localhost:8084
QUICKQUIZ_CONTENT_ROOT=../content-demo
API_LOG_LEVEL=info
API_CORS_ALLOWED_ORIGINS=*
API_HTTP_READ_HEADER_TIMEOUT=5s
API_HTTP_READ_TIMEOUT=15s
API_HTTP_WRITE_TIMEOUT=15s
API_HTTP_IDLE_TIMEOUT=60s
API_STORAGE_STARTUP_TIMEOUT=30s
API_REDIS_CONNECT_TIMEOUT=5s
ADS_API_LOG_LEVEL=info
ADS_API_CORS_ALLOWED_ORIGINS=*
ADS_API_HTTP_READ_HEADER_TIMEOUT=5s
ADS_API_HTTP_READ_TIMEOUT=15s
ADS_API_HTTP_WRITE_TIMEOUT=15s
ADS_API_HTTP_IDLE_TIMEOUT=60s
ADS_API_STORAGE_STARTUP_TIMEOUT=30s

QUESTION_STORAGE_PROVIDER=local
ADS_STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
# AWS_ACCESS_KEY_ID__FILE=/run/secrets/aws_access_key_id
AWS_SECRET_ACCESS_KEY=
# AWS_SECRET_ACCESS_KEY__FILE=/run/secrets/aws_secret_access_key
AWS_SESSION_TOKEN=
# AWS_SESSION_TOKEN__FILE=/run/secrets/aws_session_token
S3_BUCKET=
S3_PREFIX=questions
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false

FALLBACK_LOCALE=en-US
SUPPORTED_LOCALES=en-US,pt-BR
RUN_QUESTION_LIMIT=10
RUN_STORAGE_PROVIDER=redis
SOLUTION_STORAGE_PROVIDER=redis
SESSION_TTL=30m
SOLUTION_TTL=168h
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
# REDIS_PASSWORD__FILE=/run/secrets/redis_password
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=quickquiz:runs:
REDIS_SOLUTION_KEY_PREFIX=quickquiz:solutions:
REDIS_MAXMEMORY=256mb
REDIS_MEMORY_LIMIT=384m

# MANAGER_APP_SECRET__FILE=/run/secrets/app_secret
MANAGER_APP_SECRET=change-me-for-local-only
# MANAGER_ADMIN_API_TOKEN__FILE=/run/secrets/admin_api_token
MANAGER_ADMIN_API_TOKEN=
MANAGER_VERSION=0.10.0
# MANAGER_DATABASE_URL__FILE=/run/secrets/database_url
MANAGER_DATABASE_URL=postgresql://quickquiz:quickquiz-local@manager-db:5432/quickquiz_manager
MANAGER_CONTENT_STORAGE_PROVIDER=local
MANAGER_DB_NAME=quickquiz_manager
MANAGER_DB_USER=quickquiz
# MANAGER_DB_PASSWORD__FILE=/run/secrets/db_password
MANAGER_DB_PASSWORD=quickquiz-local
MANAGER_DB_MEMORY_LIMIT=256m
MANAGER_DB_SHARED_BUFFERS=64MB
MANAGER_DB_MAX_CONNECTIONS=30
# MANAGER_SESSION_REDIS_DSN__FILE=/run/secrets/session_redis_dsn
MANAGER_SESSION_REDIS_DSN=redis://redis:6379/1
MANAGER_SESSION_TTL=3600
MANAGER_SESSION_PREFIX=quickquiz:manager:session:
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
QUICKQUIZ_API_BASE_URL=http://api:8080
QUICKQUIZ_API_TIMEOUT=3
QUICKQUIZ_ADS_API_BASE_URL=http://ads-api:8080
QUICKQUIZ_ADS_API_TIMEOUT=5
MANAGER_PHP_MEMORY_LIMIT=128M
MANAGER_PHP_POST_MAX_SIZE=2M
MANAGER_PHP_UPLOAD_MAX_FILESIZE=2M
MANAGER_PHP_OPCACHE_MEMORY=96
MANAGER_FPM_MAX_CHILDREN=8
MANAGER_FPM_START_SERVERS=2
MANAGER_FPM_MIN_SPARE_SERVERS=1
MANAGER_FPM_MAX_SPARE_SERVERS=3
QUICKQUIZ_RUNTIME_UID=1000
QUICKQUIZ_RUNTIME_GID=1000

OPENAI_API_KEY=
# OPENAI_API_KEY__FILE=/run/secrets/openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=45
OPENAI_MODELS_TIMEOUT=15
OPENAI_MODEL=
OPENAI_PROJECT=
OPENAI_ORG_ID=

# API-only OpenAI settings used by the solution generation endpoint.
# API_OPENAI_API_KEY__FILE=/run/secrets/openai_api_key
API_OPENAI_API_KEY=
API_OPENAI_BASE_URL=https://api.openai.com/v1
API_OPENAI_MODEL=gpt-5.4-mini
API_OPENAI_ORG_ID=
API_OPENAI_PROJECT=
# Used only with QUESTION_STORAGE_PROVIDER=local.
API_OPENAI_SOLUTION_PROMPT_FILE=/app/.local/{{theme}}/ai-prompts/question-solution-prompt.txt
API_OPENAI_TIMEOUT=30s
