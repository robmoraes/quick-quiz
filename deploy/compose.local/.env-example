COMPOSE_PROJECT_NAME=quickquiz-dev

QUICKQUIZ_IMAGE_API=robmoraes/quick-quiz-api:latest
QUICKQUIZ_IMAGE_REDIS=redis:7.4-alpine
QUICKQUIZ_IMAGE_POSTGRES=postgres:17-alpine
QUICKQUIZ_IMAGE_ADS_API=robmoraes/quick-quiz-ads-api:latest
QUICKQUIZ_IMAGE_DEV=robmoraes/quick-quiz-dev:latest
QUICKQUIZ_IMAGE_DSLAB=robmoraes/quick-quiz-dslab:latest
QUICKQUIZ_IMAGE_MANAGER_FPM=robmoraes/quick-quiz-manager-fpm:latest
QUICKQUIZ_IMAGE_MANAGER_WEB=robmoraes/quick-quiz-manager-web:latest

API_HTTP_PORT=8080
ADS_API_HTTP_PORT=8084
SPA_HTTP_PORT=8082
DSLAB_HTTP_PORT=8083
MANAGER_HTTP_PORT=8081
VITE_API_BASE_URL=http://localhost:8080
VITE_ADS_API_BASE_URL=http://localhost:8084
QUICKQUIZ_CONTENT_ROOT=../content-demo
QUESTION_STORAGE_PROVIDER=local
ADS_STORAGE_PROVIDER=local
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=questions
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false

FALLBACK_LOCALE=en-US
SUPPORTED_LOCALES=en-US,pt-BR
RUN_QUESTION_LIMIT=10
RUN_STORAGE_PROVIDER=redis
SOLUTION_STORAGE_PROVIDER=memory
SESSION_TTL=30m
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=quickquiz:runs:
REDIS_MAXMEMORY=256mb
REDIS_MEMORY_LIMIT=384m

MANAGER_APP_SECRET=change-me-for-local-only
MANAGER_DATABASE_URL=postgresql://quickquiz:quickquiz-local@manager-db:5432/quickquiz_manager
MANAGER_CONTENT_STORAGE_PROVIDER=local
MANAGER_DB_NAME=quickquiz_manager
MANAGER_DB_USER=quickquiz
MANAGER_DB_PASSWORD=quickquiz-local
MANAGER_DB_MEMORY_LIMIT=256m
MANAGER_SESSION_REDIS_DSN=redis://redis:6379/1
MANAGER_SESSION_TTL=3600
MANAGER_SESSION_PREFIX=quickquiz:manager:session:
QUICKQUIZ_API_BASE_URL=http://api:8080
QUICKQUIZ_ADS_API_BASE_URL=http://ads-api:8080
QUICKQUIZ_RUNTIME_UID=1000
QUICKQUIZ_RUNTIME_GID=1000

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROJECT=
OPENAI_ORG_ID=

# API-only OpenAI settings used by the solution generation endpoint.
API_OPENAI_API_KEY=
API_OPENAI_BASE_URL=https://api.openai.com/v1
API_OPENAI_MODEL=gpt-5.4-mini
API_OPENAI_ORG_ID=
API_OPENAI_PROJECT=
API_OPENAI_SOLUTION_PROMPT_FILE=/app/.local/{{theme}}/ai-prompts/question-solution-prompt.txt
API_OPENAI_TIMEOUT=30s
