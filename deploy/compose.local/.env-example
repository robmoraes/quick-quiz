COMPOSE_PROJECT_NAME=quickquiz-dev

QUICKQUIZ_IMAGE_API=robmoraes/quick-quiz-api:latest
QUICKQUIZ_IMAGE_DEV=robmoraes/quick-quiz-dev:latest
QUICKQUIZ_IMAGE_MANAGER_FPM=robmoraes/quick-quiz-manager-fpm:latest
QUICKQUIZ_IMAGE_MANAGER_WEB=robmoraes/quick-quiz-manager-web:latest

API_HTTP_PORT=8080
SPA_HTTP_PORT=8082
MANAGER_HTTP_PORT=8081
VITE_API_BASE_URL=http://localhost:8080
QUICKQUIZ_CONTENT_ROOT=../content-demo

FALLBACK_LOCALE=en-US
SUPPORTED_LOCALES=en-US,pt-BR
RUN_QUESTION_LIMIT=10
SESSION_TTL=30m

MANAGER_APP_SECRET=change-me-for-local-only
MANAGER_DATABASE_URL=sqlite:////content/.manager/manager.sqlite
QUICKQUIZ_RUNTIME_UID=1000
QUICKQUIZ_RUNTIME_GID=1000

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROJECT=
OPENAI_ORG_ID=
