{% extends 'layout/base.html.twig' %}

{% block title %}Catalog - QuickQuiz Manager{% endblock %}

{% block body %}
  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <h1 class="h3 mb-0">Catalog</h1>
    <div class="d-flex gap-2">
      <a class="btn btn-primary" href="{{ path('catalog_new') }}">New topic</a>
      <a class="btn btn-outline-secondary" href="{{ path('questions') }}">Manage questions</a>
    </div>
  </div>

  <section class="card mb-3">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3">Content root</dt>
        <dd class="col-sm-9"><code>{{ contentRoot }}</code></dd>
        <dt class="col-sm-3">Selected theme</dt>
        <dd class="col-sm-9">
          <code>{{ selectedTheme }}</code>
          {% if theme and not theme.active %}
            <span class="badge text-bg-secondary ms-2">inactive for player APIs</span>
          {% endif %}
        </dd>
        <dt class="col-sm-3">Fallback locale</dt>
        <dd class="col-sm-9">{{ fallbackLocale }}</dd>
        <dt class="col-sm-3">Supported locales</dt>
        <dd class="col-sm-9">{{ supportedLocales|join(', ') }}</dd>
      </dl>
    </div>
  </section>

  {% if validationErrors %}
    <section class="alert alert-warning">
      <strong>Validation issues</strong>
      <ul class="mb-0">
        {% for issue in validationErrors %}
          <li>{{ issue }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <form class="manager-sort-controls" method="get" action="{{ path('catalog') }}">
    <div class="manager-keyword-filter">
      <label class="form-label" for="keyword">Keyword</label>
      <input
        class="form-control"
        id="keyword"
        name="keyword"
        value="{{ keyword }}"
        placeholder="Key, name, or description">
    </div>
    <div>
      <label class="form-label" for="sortField">Sort field</label>
      <select class="form-select" id="sortField" name="sortField">
        <option value="">Default</option>
        <option value="key" {% if sortField == 'key' %}selected{% endif %}>Key</option>
        <option value="name" {% if sortField == 'name' %}selected{% endif %}>Name</option>
        <option value="weight" {% if sortField == 'weight' %}selected{% endif %}>Weight</option>
        <option value="created" {% if sortField == 'created' %}selected{% endif %}>Created</option>
      </select>
    </div>
    <div>
      <label class="form-label" for="sortDirection">Direction</label>
      <select class="form-select" id="sortDirection" name="sortDirection">
        <option value="asc" {% if sortDirection != 'desc' %}selected{% endif %}>Ascending</option>
        <option value="desc" {% if sortDirection == 'desc' %}selected{% endif %}>Descending</option>
      </select>
    </div>
    <div class="manager-sort-submit">
      <button class="btn btn-outline-secondary" type="submit">Apply</button>
      {% if keyword or sortField %}
        <a class="btn btn-outline-secondary" href="{{ path('catalog') }}">Clear</a>
      {% endif %}
    </div>
  </form>

  <div class="table-responsive">
    <table class="table table-hover align-middle manager-table">
      <thead>
      <tr>
        <th>Key</th>
        <th>Name</th>
        <th>Weight</th>
        <th>Created</th>
        <th>Status</th>
        <th>Questions</th>
        <th>Actions</th>
      </tr>
      </thead>
      <tbody>
      {% for topic in topics %}
        <tr>
          <td><code>{{ topic.key }}</code></td>
          <td>
            <strong>{{ topic.name|default(topic.key) }}</strong>
            <div class="text-muted small">{{ topic.description|default('') }}</div>
          </td>
          <td>{{ topic.weight }}</td>
          <td data-manager-created-at-display="{{ topic.created_at|default('') }}">{{ topic.created_at|default('') }}</td>
          <td>{% if topic.active %}<span class="badge text-bg-info">active</span>{% else %}<span class="text-muted">inactive</span>{% endif %}</td>
          <td>{{ topic.questionCount }}</td>
          <td class="manager-actions-cell">
            <div class="manager-action-row">
              <a
                class="btn btn-sm btn-outline-secondary"
                href="{{ path('catalog_edit', {key: topic.key}) }}"
                title="Edit topic"
                aria-label="Edit topic">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
              </a>
              {% for locale in supportedLocales %}
                <a
                  class="btn btn-sm btn-outline-secondary"
                  href="{{ path('catalog_localization', {locale: locale, key: topic.key}) }}"
                  title="Edit {{ locale }} localization"
                  aria-label="Edit {{ locale }} localization">
                  {{ locale|split('-')|first }}
                </a>
              {% endfor %}
              <a
                class="btn btn-sm btn-outline-primary"
                href="{{ path('questions', {topic: topic.key, locale: fallbackLocale, difficulty: 1}) }}"
                title="Manage questions"
                aria-label="Manage questions">
                <i class="bi bi-card-checklist" aria-hidden="true"></i>
              </a>
            </div>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="7">No topics configured.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
