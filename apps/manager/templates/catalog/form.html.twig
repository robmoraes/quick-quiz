{% extends 'layout/base.html.twig' %}

{% block title %}Topic - QuickQuiz Manager{% endblock %}

{% block body %}
  <h1 class="h3 mb-3">{% if isNew %}New topic{% else %}Edit topic{% endif %}</h1>
  <section class="card">
    <div class="card-body">
      {% if error is defined %}
        <p class="alert alert-danger">{{ error }}</p>
      {% endif %}
      <form method="post" action="{{ path('catalog_save') }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="key">Key</label>
            <input class="form-control" id="key" name="key" value="{{ topic.key|default('') }}" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="weight">Weight</label>
            <input class="form-control" id="weight" name="weight" type="number" value="{{ topic.weight|default(0) }}">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="name">Fallback name</label>
          <input class="form-control" id="name" name="name" value="{{ topic.name|default('') }}">
        </div>
        <div class="mb-3">
          <label class="form-label" for="description">Fallback description</label>
          <textarea class="form-control" id="description" name="description">{{ topic.description|default('') }}</textarea>
        </div>
        <div class="row align-items-end">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="created_at">Created at</label>
            <input class="form-control" id="created_at" name="created_at" value="{{ topic.created_at|default('') }}" placeholder="2026-01-01T00:00:00-03:00">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-check">
              <input class="form-check-input" type="checkbox" name="active" value="1" {% if topic.active|default(false) %}checked{% endif %}>
              <span class="form-check-label">Active</span>
            </label>
          </div>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary" type="submit">Save</button>
          <a class="btn btn-outline-secondary" href="{{ path('catalog') }}">Cancel</a>
        </div>
      </form>
      {% if not isNew %}
        <form method="post" action="{{ path('catalog_delete', {key: topic.key}) }}" class="mt-3" onsubmit="return confirm('Delete topic metadata {{ topic.key }}? This cannot be undone.');">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <button class="btn btn-danger" type="submit">Delete topic metadata</button>
        </form>
      {% endif %}
    </div>
  </section>
{% endblock %}
