{% extends 'layout/base.html.twig' %}

{% block title %}Theme - QuickQuiz Manager{% endblock %}

{% block body %}
  <h1 class="h3 mb-3">{% if isNew %}New theme{% else %}Edit theme{% endif %}</h1>
  <section class="card">
    <div class="card-body">
      {% if error is defined %}
        <p class="alert alert-danger">{{ error }}</p>
      {% endif %}
      <form method="post" action="{{ path('theme_save') }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="id">Theme ID</label>
            <input class="form-control" id="id" name="id" value="{{ theme.id|default('') }}" required {% if not isNew %}readonly{% endif %}>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="weight">Weight</label>
            <input class="form-control" id="weight" name="weight" type="number" value="{{ theme.weight|default(0) }}">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="name">Canonical English name</label>
          <input class="form-control" id="name" name="name" value="{{ theme.name|default('') }}">
        </div>
        <div class="mb-3">
          <label class="form-label" for="description">Canonical English description</label>
          <textarea class="form-control" id="description" name="description">{{ theme.description|default('') }}</textarea>
        </div>
        <div class="mb-3">
          <label class="form-label" for="tags">Tags</label>
          <input class="form-control" id="tags" name="tags" aria-describedby="tags-help"
                 {% if quizPublication.provider|default('legacy') != 'postgres' %}disabled{% endif %}
                 value="{{ theme.tags is defined and theme.tags is iterable ? theme.tags|join(', ') : theme.tags|default('') }}">
          <div class="form-text" id="tags-help">Separate tags with commas, for example: dev, cloud. Up to 20 tags, 50 characters each. Use letters, digits, and hyphens. Requires PostgreSQL authoring; publication and API reload apply.</div>
        </div>
        <div class="row align-items-end">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="createdAt">Created at</label>
            <input class="form-control" id="createdAt" name="createdAt" value="{{ theme.createdAt|default('') }}" placeholder="2026-01-01T00:00:00-03:00">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-check">
              <input class="form-check-input" type="checkbox" name="active" value="1" {% if theme.active|default(false) %}checked{% endif %}>
              <span class="form-check-label">Active for player APIs</span>
            </label>
          </div>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary" type="submit">Save</button>
          <a class="btn btn-outline-secondary" href="{{ path('themes') }}">Cancel</a>
        </div>
      </form>
    </div>
  </section>
{% endblock %}
