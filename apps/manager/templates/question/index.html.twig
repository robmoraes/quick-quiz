{% extends 'layout/base.html.twig' %}

{% block title %}Questions - QuickQuiz Manager{% endblock %}

{% block ai_help %}
  {% if aiAvailable %}
    {% include 'components/ai_help_drawer.html.twig' with {
      items: [
        {
          title: 'Create with AI',
          body: '<p>Starts a new AI-assisted question draft for the selected topic and difficulty. Use it when you want AI to propose the question prompt and answer options.</p>'
        },
        {
          title: 'Edit with AI',
          body: '<p>Opens an existing question in the AI-assisted editor for the selected locale. Use it to adjust the prompt, options, or localized content with AI support.</p>'
        }
      ]
    } %}
  {% endif %}
{% endblock %}

{% block body %}
  <h1 class="h3 mb-3">Questions</h1>
  <section class="card mb-3">
    <div class="card-body">
      {% if error|default('') %}
        <p class="alert alert-danger">{{ error }}</p>
      {% endif %}
      {% if deleteResult.questionId|default('') %}
        <p class="alert alert-success">
          Question <code>{{ deleteResult.questionId }}</code> deleted across {{ deleteResult.deletedLocales }} locale(s).
          {% if deleteResult.missingLocales > 0 %}
            {{ deleteResult.missingLocales }} locale variant(s) were already missing.
          {% endif %}
        </p>
      {% endif %}
      <form method="get" action="{{ path('questions') }}">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label" for="locale">Locale</label>
          <select class="form-select" id="locale" name="locale">
            {% for locale in locales %}
              <option value="{{ locale }}" {% if locale == selectedLocale %}selected{% endif %}>{{ locale }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label" for="topic">Topic</label>
          <select class="form-select" id="topic" name="topic">
            {% for topic in topics %}
              <option value="{{ topic.key }}" {% if topic.key == selectedTopic %}selected{% endif %}>
                {{ topic.key }}{% if not topic.active %} (inactive){% endif %}
              </option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label" for="difficulty">Difficulty</label>
          <select class="form-select" id="difficulty" name="difficulty">
            {% for id, difficulty in difficulties %}
              <option value="{{ id }}" {% if id == selectedDifficulty %}selected{% endif %}>{{ id }} - {{ difficulty.label }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div class="d-flex align-items-center">
        <button
          class="btn btn-primary"
          type="submit"
          formmethod="get"
          formaction="{{ path('questions') }}">
          Filter
        </button>

        <div class="ms-auto d-flex gap-2">
          <a
            class="btn btn-outline-secondary"
            href="{{ path('question_manual_new', {locale: selectedLocale, topic: selectedTopic, difficulty: selectedDifficulty}) }}">
            Create
          </a>

          {% if aiAvailable %}
            <a
              class="btn btn-outline-primary"
              href="{{ path('question_ai_new', {topic: selectedTopic, difficulty: selectedDifficulty}) }}">
              <i class="bi bi-stars" aria-hidden="true"></i>
              Create with AI
            </a>
          {% endif %}
        </div>
      </div>
      </form>
    </div>
  </section>

  <div class="table-responsive manager-questions-table-container">
    <table class="table table-hover align-middle manager-table">
      <thead>
      <tr>
        <th>ID</th>
        <th>Prompt</th>
        <th>Correct</th>
        <th>Wrong</th>
        <th>Actions</th>
      </tr>
      </thead>
      <tbody>
      {% for question in questions %}
        <tr>
          <td><code>{{ question.id }}</code></td>
          <td>{{ question.prompt }}</td>
          <td>{{ question.correctCount }}</td>
          <td>{{ question.wrongCount }}</td>
          <td style="min-width: 150px;">
            <a
              class="btn btn-sm btn-outline-secondary"
              href="{{ path('question_manual_edit', {topic: selectedTopic, difficulty: selectedDifficulty, id: question.id}) }}"
              title="Manual edit"
              aria-label="Manual edit">
              <i class="bi bi-pencil-square" aria-hidden="true"></i>
            </a>
            {% if aiAvailable %}
              <div class="dropdown d-inline">
                <button
                  class="btn btn-sm btn-outline-primary dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  title="Edit with AI"
                  aria-label="Edit with AI">
                  <i class="bi bi-stars" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu">
                  {% for locale in locales %}
                    <li>
                      <a class="dropdown-item" href="{{ path('question_ai_edit', {locale: locale, topic: selectedTopic, difficulty: selectedDifficulty, id: question.id}) }}">{{ locale }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            <form class="d-inline ms-2" method="post" action="{{ path('question_delete') }}" onsubmit="return confirm('Delete question {{ question.id }} across all locales? This cannot be undone.');">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="locale" value="{{ selectedLocale }}">
              <input type="hidden" name="topic" value="{{ selectedTopic }}">
              <input type="hidden" name="difficulty" value="{{ selectedDifficulty }}">
              <input type="hidden" name="questionId" value="{{ question.id }}">
              <button
                class="btn btn-sm btn-danger"
                type="submit"
                title="Delete across all locales"
                aria-label="Delete across all locales">
                <i class="bi bi-trash" aria-hidden="true"></i>
              </button>
            </form>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="5">No questions found.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
