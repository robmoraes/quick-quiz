{% extends 'layout/base.html.twig' %}

{% block title %}New question with AI - QuickQuiz Manager{% endblock %}

{% block body %}
  <h1 class="h3 mb-3">New question with AI</h1>
  <section class="card">
    <div class="card-body">
      {% if error is defined %}
        <p class="alert alert-danger">{{ error }}</p>
      {% endif %}
      <form method="post" action="{{ path('question_ai_save') }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="row">
          <div class="col-md-4 mb-3">
            <label class="form-label" for="topic">Topic</label>
            <select class="form-select" id="topic" name="topic">
              {% for item in topics %}
                <option value="{{ item.key }}" {% if item.key == topic %}selected{% endif %}>
                  {{ item.key }}{% if not item.active %} (inactive){% endif %}
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label" for="difficulty">Difficulty</label>
            <select class="form-select" id="difficulty" name="difficulty">
              {% for id, item in difficulties %}
                <option value="{{ id }}" {% if id == difficulty %}selected{% endif %}>{{ id }} - {{ item.label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label" for="questionId">Question ID</label>
            <input class="form-control text-mono" id="questionId" name="questionId" value="{{ questionId }}" placeholder="{{ suggestedQuestionId|default('auto-generated') }}">
            <div class="form-text">Leave blank to create <code>{{ suggestedQuestionId|default('the next ID') }}</code>.</div>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="prompt">Prompt</label>
          <textarea class="form-control" id="prompt" name="prompt" required>{{ question.prompt }}</textarea>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="correctOptions">Correct options, one per line</label>
            <textarea class="form-control text-mono" id="correctOptions" name="correctOptions" required>{{ question.correctOptions|join("\n") }}</textarea>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="wrongOptions">Wrong options, one per line</label>
            <textarea class="form-control text-mono" id="wrongOptions" name="wrongOptions" style="min-height: 300px;" required>{{ question.wrongOptions|join("\n") }}</textarea>
          </div>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="translateOptions" name="translateOptions" value="1" {% if translateOptions|default(false) %}checked{% endif %}>
          <label class="form-check-label" for="translateOptions">Translate answer options</label>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary" type="submit">Create localized questions</button>
          <a class="btn btn-outline-secondary" href="{{ path('questions', {locale: fallbackLocale, topic: topic, difficulty: difficulty}) }}">Cancel</a>
        </div>
      </form>
    </div>
  </section>
{% endblock %}
