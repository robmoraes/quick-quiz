{% extends 'layout/base.html.twig' %}

{% block title %}{% if mode == 'edit' %}Edit with AI{% else %}Create with AI{% endif %} - QuickQuiz Manager{% endblock %}

{% block ai_help %}
  {% include 'components/ai_help_drawer.html.twig' with {
    items: [
      {
        title: 'Generate question and answers',
        body: '<p>Creates a complete draft for the selected locale, topic, and difficulty. Text entered in Prompt is treated as generation guidance, not as the final question statement.</p>'
      },
      {
        title: 'Suggest answers with AI',
        body: '<p>Uses the current Prompt as an existing question and asks AI to suggest only correct and wrong answer options without rewriting the prompt.</p>'
      },
      {
        title: 'Translate answer options',
        body: '<p>When enabled, saving with AI localizes the prompt and answer options for supported locales. When disabled, AI localizes only the prompt and copies answer options.</p>'
      },
      {
        title: 'Save with AI localization',
        body: '<p>Saves the source question and asks AI to create or update the required localized question files for the supported locales.</p>'
      }
    ]
  } %}
{% endblock %}

{% block body %}
  <h1 class="h3 mb-3">{% if mode == 'edit' %}Edit with AI{% else %}Create with AI{% endif %}</h1>
  <section class="card">
    <div class="card-body">
      {% if error|default('') %}
        <p class="alert alert-danger">{{ error }}</p>
      {% endif %}

      <form method="post" action="{{ path('question_ai_save') }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="mode" value="{{ mode }}">
        <input type="hidden" name="sourceLocale" value="{{ sourceLocale }}">

        <div class="row">
          {% if mode == 'edit' %}
            <div class="col-md-3 mb-3">
              <label class="form-label">Base locale</label>
              <div class="form-control-plaintext"><code>{{ sourceLocale }}</code></div>
            </div>
            <input type="hidden" name="topic" value="{{ topic }}">
            <input type="hidden" name="difficulty" value="{{ difficulty }}">
          {% else %}
            <div class="col-md-4 mb-3">
              <label class="form-label" for="topic">Topic</label>
              <select class="form-select" id="topic" name="topic">
                {% for item in topics %}
                  <option value="{{ item.key }}" {% if item.key == topic %}selected{% endif %}>
                    {{ item.key }}{% if not item.active %} (inactive){% endif %}
                  </option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label" for="difficulty">Difficulty</label>
              <select class="form-select" id="difficulty" name="difficulty">
                {% for id, item in difficulties %}
                  <option value="{{ id }}" {% if id == difficulty %}selected{% endif %}>{{ id }} - {{ item.label }}</option>
                {% endfor %}
              </select>
            </div>
          {% endif %}
          <div class="{% if mode == 'edit' %}col-md-3{% else %}col-md-4{% endif %} mb-3">
            <label class="form-label" for="questionId">Question ID</label>
            <input
              class="form-control text-mono"
              id="questionId"
              name="questionId"
              value="{{ questionId }}"
              placeholder="{{ suggestedQuestionId|default('auto-generated') }}"
              {% if mode == 'edit' %}readonly{% endif %}>
            {% if mode != 'edit' %}
              <div class="form-text">Leave blank to create <code>{{ suggestedQuestionId|default('the next ID') }}</code>.</div>
            {% endif %}
          </div>
        </div>

        <div class="mb-3">
          <div class="btn-group">
            <button
              class="btn btn-outline-primary dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              {% if topic == '' %}disabled{% endif %}>
              <i class="bi bi-stars" aria-hidden="true"></i>
              Generate question and answers
            </button>
            <ul class="dropdown-menu">
              {% for locale in supportedLocales %}
                <li>
                  <button
                    class="dropdown-item"
                    type="submit"
                    name="sourceLocale"
                    value="{{ locale }}"
                    formaction="{{ path('question_ai_recommend') }}"
                    formnovalidate
                    onclick="return confirm('This action uses AI. Continue?');">
                    {{ locale }}
                  </button>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="prompt">Prompt</label>
          <textarea class="form-control" id="prompt" name="prompt" required>{{ question.prompt }}</textarea>
        </div>

        <div class="mb-3">
          <button
            class="btn btn-outline-primary"
            type="submit"
            formaction="{{ path('question_ai_suggest_answers') }}"
            formnovalidate
            onclick="return confirm('This action uses AI. Continue?');"
            {% if topic == '' %}disabled{% endif %}>
            <i class="bi bi-stars" aria-hidden="true"></i>
            Suggest answers with AI
          </button>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="correctOptions">Correct options, one per line</label>
            <textarea class="form-control text-mono" id="correctOptions" name="correctOptions" required>{{ question.correctOptions|join("\n") }}</textarea>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="wrongOptions">Wrong options, one per line</label>
            <textarea class="form-control text-mono" id="wrongOptions" name="wrongOptions" style="min-height: 300px;" required>{{ question.wrongOptions|join("\n") }}</textarea>
          </div>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="translateOptions" name="translateOptions" value="1" {% if translateOptions|default(false) %}checked{% endif %}>
          <label class="form-check-label" for="translateOptions">
            <i class="bi bi-stars" aria-hidden="true"></i>
            Translate answer options
          </label>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-primary" type="submit" onclick="return confirm('Saving this form uses AI to localize content. Continue?');">Save</button>
          <a class="btn btn-outline-secondary" href="{{ path('questions', {locale: sourceLocale, topic: topic, difficulty: difficulty}) }}">Cancel</a>
        </div>
      </form>
    </div>
  </section>
{% endblock %}
