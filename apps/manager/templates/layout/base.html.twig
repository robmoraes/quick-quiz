<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}QuickQuiz Manager{% endblock %}</title>
    <link rel="icon" type="image/png" sizes="128x128" href="/icons/favicon-128x128.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/icons/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="icon" type="image/ico" href="/favicon.ico">
    {{ importmap('app') }}
  </head>
  <body>
    <nav class="navbar navbar-expand-lg border-bottom manager-navbar">
      <div class="container-fluid app-shell">
        <a class="navbar-brand fw-semibold" href="{{ selectedTheme ? path('catalog') : path('themes') }}">QuickQuiz Manager</a>
        {% if adminEmail %}
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#managerNav" aria-controls="managerNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="managerNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a class="nav-link" href="{{ path('themes') }}">Themes</a>
              </li>
              {% if selectedTheme %}
                <li class="nav-item">
                  <a class="nav-link" href="{{ path('catalog') }}">Catalog</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="{{ path('questions') }}">Questions</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="{{ path('stats') }}">Stats</a>
                </li>
              {% endif %}
            </ul>
            <div class="d-flex align-items-center gap-3">
              {% if selectedTheme %}
                <a class="badge text-bg-dark text-decoration-none" href="{{ path('themes') }}">Theme: {{ selectedTheme }}</a>
              {% else %}
                <a class="badge text-bg-warning text-dark text-decoration-none" href="{{ path('themes') }}">No theme selected</a>
              {% endif %}
              <span class="manager-muted small">{{ adminEmail }}</span>
              <form method="post" action="{{ path('logout') }}">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <button class="btn btn-outline-secondary btn-sm" type="submit">Logout</button>
              </form>
            </div>
          </div>
        {% endif %}
      </div>
    </nav>
    {% block ai_help %}{% endblock %}
    <main class="container-fluid app-shell py-4">
      {% block body %}{% endblock %}
    </main>
    <footer class="manager-status-footer fixed-bottom border-top">
      <div class="container-fluid app-shell d-flex align-items-center justify-content-between gap-3 py-2">
        <span class="small manager-muted">QuickQuiz Manager · v{{ managerVersion }}</span>
        {% if openAiConfigured %}
          <span class="badge text-bg-success">AI active · {{ openAiModel }}</span>
        {% else %}
          <span class="badge text-bg-secondary">AI inactive</span>
        {% endif %}
      </div>
    </footer>
  </body>
</html>
