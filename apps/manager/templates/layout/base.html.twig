<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}QuickQuiz Manager{% endblock %}</title>
    <link rel="icon" type="image/png" sizes="128x128" href="/icons/favicon-128x128.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/icons/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="icon" type="image/ico" href="/favicon.ico">
    {{ importmap('app') }}
  </head>
  <body class="{% if adminEmail %}manager-has-sidebar{% endif %}">
    <header class="manager-topbar border-bottom">
      <div class="container-fluid app-shell manager-topbar-shell">
        <div class="d-flex align-items-center gap-2">
          {% if adminEmail %}
            <button class="btn btn-outline-secondary btn-sm manager-menu-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#managerSidebar" aria-controls="managerSidebar" aria-label="Open navigation">
              <i class="bi bi-list" aria-hidden="true"></i>
            </button>
          {% endif %}
          <a class="navbar-brand fw-semibold" href="{{ selectedTheme ? path('catalog') : path('themes') }}">QuickQuiz Manager</a>
        </div>
        {% if adminEmail %}
          <div class="manager-topbar-actions">
            {% if selectedTheme %}
              <a class="badge text-bg-dark text-decoration-none" href="{{ path('themes') }}">Theme: {{ selectedTheme }}</a>
            {% else %}
              <a class="badge text-bg-warning text-dark text-decoration-none" href="{{ path('themes') }}">No theme selected</a>
            {% endif %}
            <span class="manager-muted small">{{ adminEmail }}</span>
            <form method="post" action="{{ path('logout') }}">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <button class="btn btn-outline-secondary btn-sm" type="submit">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                <span>Logout</span>
              </button>
            </form>
          </div>
        {% endif %}
      </div>
    </header>
    {% if adminEmail %}
      <aside class="offcanvas-lg offcanvas-start manager-sidebar" tabindex="-1" id="managerSidebar" aria-labelledby="managerSidebarLabel">
        <div class="offcanvas-header">
          <h2 class="offcanvas-title h5" id="managerSidebarLabel">QuickQuiz</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#managerSidebar" aria-label="Close navigation"></button>
        </div>
        <div class="offcanvas-body">
          <nav class="manager-sidebar-nav" aria-label="Primary navigation">
            <a class="manager-sidebar-link {% if currentPath starts with '/themes' %}active{% endif %}" href="{{ path('themes') }}">
              <i class="bi bi-palette" aria-hidden="true"></i>
              <span>Themes</span>
            </a>
            <a class="manager-sidebar-link {% if currentPath starts with '/ads' %}active{% endif %}" href="{{ path('ads') }}">
              <i class="bi bi-badge-ad" aria-hidden="true"></i>
              <span>Advertising</span>
            </a>
            <a class="manager-sidebar-link {% if currentPath starts with '/sessions' %}active{% endif %}" href="{{ path('session_monitor') }}">
              <i class="bi bi-activity" aria-hidden="true"></i>
              <span>Sessions</span>
            </a>
            <a class="manager-sidebar-link {% if currentPath starts with '/ai-prompts' %}active{% endif %}" href="{{ path('ai_prompts') }}">
              <i class="bi bi-stars" aria-hidden="true"></i>
              <span>AI Prompts</span>
            </a>
            {% if selectedTheme %}
              <div class="manager-sidebar-section">Selected theme</div>
              <a class="manager-sidebar-link {% if currentPath starts with '/catalog' %}active{% endif %}" href="{{ path('catalog') }}">
                <i class="bi bi-journal-text" aria-hidden="true"></i>
                <span>Catalog</span>
              </a>
              <a class="manager-sidebar-link {% if currentPath starts with '/questions' %}active{% endif %}" href="{{ path('questions') }}">
                <i class="bi bi-ui-checks" aria-hidden="true"></i>
                <span>Questions</span>
              </a>
              <a class="manager-sidebar-link {% if currentPath starts with '/stats' %}active{% endif %}" href="{{ path('stats') }}">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                <span>Stats</span>
              </a>
            {% endif %}
          </nav>
        </div>
      </aside>
    {% endif %}
    {% block ai_help %}{% endblock %}
    <main class="container-fluid app-shell manager-main {% if adminEmail %}manager-main-with-sidebar{% endif %} py-4">
      {% block body %}{% endblock %}
    </main>
    <footer class="manager-status-footer fixed-bottom border-top">
      <div class="container-fluid app-shell d-flex align-items-center justify-content-between gap-3 py-2">
        <span class="small manager-muted">QuickQuiz Manager · v{{ managerVersion }}</span>
        {% if openAiConfigured %}
          <form class="manager-ai-model-form" method="post" action="{{ path('openai_model_select') }}">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="returnTo" value="{{ currentPath }}">
            <label class="visually-hidden" for="openai-model">OpenAI model</label>
            <span class="badge text-bg-success manager-ai-model-badge">
              <select class="form-select form-select-sm manager-ai-model-select" id="openai-model" name="model" onchange="this.form.submit()">
                {% for model in openAiModels %}
                  <option value="{{ model }}" {% if model == openAiModel %}selected{% endif %}>{{ model }}</option>
                {% else %}
                  <option value="{{ openAiModel }}" selected>{{ openAiModel }}</option>
                {% endfor %}
              </select>
            </span>
          </form>
        {% else %}
          <span class="badge text-bg-secondary">AI inactive</span>
        {% endif %}
      </div>
    </footer>
  </body>
</html>
