# For sensitive values, NAME__FILE takes priority over NAME.
# The Manager fails to start when a configured file is missing or empty.
APP_ENV=dev
APP_SECRET=change-me-in-dev
# APP_SECRET__FILE=/run/secrets/app_secret
MANAGER_HTTP_PORT=8081
MANAGER_ADMIN_API_TOKEN=
# MANAGER_ADMIN_API_TOKEN__FILE=/run/secrets/admin_api_token

MANAGER_DATABASE_URL=postgresql://quickquiz:quickquiz-local@manager-db:5432/quickquiz_manager
# MANAGER_DATABASE_URL__FILE=/run/secrets/database_url
MANAGER_DB_NAME=quickquiz_manager
MANAGER_DB_USER=quickquiz
MANAGER_DB_PASSWORD=quickquiz-local
# MANAGER_DB_PASSWORD__FILE=/run/secrets/db_password
MANAGER_DB_MEMORY_LIMIT=256m
MANAGER_DB_SHARED_BUFFERS=64MB
MANAGER_DB_MAX_CONNECTIONS=30
MANAGER_CONTENT_ROOT=../api/.local
MANAGER_CONTENT_STORAGE_PROVIDER=local
MANAGER_QUIZ_PERSISTENCE_PROVIDER=legacy
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
# AWS_ACCESS_KEY_ID__FILE=/run/secrets/aws_access_key_id
AWS_SECRET_ACCESS_KEY=
# AWS_SECRET_ACCESS_KEY__FILE=/run/secrets/aws_secret_access_key
AWS_SESSION_TOKEN=
# AWS_SESSION_TOKEN__FILE=/run/secrets/aws_session_token
S3_BUCKET=
S3_PREFIX=questions
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
MANAGER_SESSION_REDIS_DSN=redis://127.0.0.1:6379/1
# MANAGER_SESSION_REDIS_DSN__FILE=/run/secrets/session_redis_dsn
MANAGER_SESSION_TTL=3600
MANAGER_SESSION_PREFIX=quickquiz:manager:session:
REDIS_PASSWORD=
# REDIS_PASSWORD__FILE=/run/secrets/redis_password
REDIS_MAXMEMORY=256mb
REDIS_MEMORY_LIMIT=384m
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
MANAGER_VERSION=0.11.2
MANAGER_DOCKER_PHP_BASE_IMAGE=robmoraes/quick-quiz-php-base:8.3.33-alpine3.24-r1
MANAGER_PHP_MEMORY_LIMIT=128M
MANAGER_PHP_POST_MAX_SIZE=2M
MANAGER_PHP_UPLOAD_MAX_FILESIZE=2M
MANAGER_PHP_OPCACHE_MEMORY=96
MANAGER_FPM_MAX_CHILDREN=8
MANAGER_FPM_START_SERVERS=2
MANAGER_FPM_MIN_SPARE_SERVERS=1
MANAGER_FPM_MAX_SPARE_SERVERS=3
QUICKQUIZ_API_BASE_URL=http://127.0.0.1:8080
QUICKQUIZ_API_TIMEOUT=3
QUICKQUIZ_ADS_API_BASE_URL=http://127.0.0.1:8084
QUICKQUIZ_ADS_API_TIMEOUT=5
RUN_QUESTION_LIMIT=10

FALLBACK_LOCALE=en-US
SUPPORTED_LOCALES=en-US,pt-BR

OPENAI_API_KEY=
# OPENAI_API_KEY__FILE=/run/secrets/openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=45
OPENAI_MODELS_TIMEOUT=15
OPENAI_MODEL=
OPENAI_PROJECT=
OPENAI_ORG_ID=
