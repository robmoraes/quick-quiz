{
  "name": "quickquiz/manager",
  "description": "QuickQuiz Dev quiz pack manager.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "symfony/asset": "^7.4",
    "symfony/asset-mapper": "^7.4",
    "symfony/console": "^7.2",
    "symfony/dotenv": "^7.2",
    "symfony/framework-bundle": "^7.2",
    "symfony/http-client": "^7.4",
    "symfony/runtime": "^7.2",
    "symfony/stimulus-bundle": "^2.36",
    "symfony/twig-bundle": "^7.2",
    "symfony/ux-turbo": "^2.36",
    "symfony/yaml": "^7.2",
    "twig/extra-bundle": "^3.15"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.2",
    "symfony/css-selector": "^7.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  }
}
